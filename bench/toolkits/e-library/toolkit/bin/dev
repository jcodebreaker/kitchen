#!/usr/bin/env node
// Kitchen Toolkit, contract v1 (generic dispatcher from Kitchen's toolkit-template).
// Every command prints exactly one JSON line on stdout; logs go to stderr.
// Don't put project knowledge here: it lives in ../app.mjs. This file keeps the
// contract (flags, ids, state, the JSON lines, describe, cleanup) the same in
// every project.
//
//   bin/dev prepare  --src <dir>                          {"status":"ok","secs":n}
//   bin/dev up       --id <id> --src <dir> --ports a,b,…  {"status":"ready","url":…} | {"status":"fail","why":…}
//   bin/dev doctor   --id <id>                            {"status":"ok"|"fail","checks":[{name,ok,why?}]}
//   bin/dev reset    --id <id>                            {"status":"ok"}
//   bin/dev down     --id <id>                            {"status":"ok","stopped":[…]}
//   bin/dev describe [--src <dir>]                        capabilities, generated
//   bin/dev <primitive> --id <id> --src <dir> --out <dir> [--arg=value…]   {"ok":bool,"out":…,"files":[…]}
import fs from "node:fs";
import path from "node:path";
import app from "../app.mjs";
import {
  CONTRACT,
  TOOLKIT_DIR,
  alive,
  appEnv,
  checkId,
  httpJson,
  killGroup,
  log,
  must,
  out,
  parseArgs,
  readEnvFile,
  run,
  spawnDetached,
  stateRoot,
  waitFor,
} from "../lib/common.mjs";

const LIFECYCLE = ["prepare", "up", "doctor", "reset", "down", "describe"];
const t0 = Date.now();
const secs = () => Math.round((Date.now() - t0) / 100) / 10;

let parsed;
try {
  parsed = parseArgs(process.argv.slice(2));
} catch (e) {
  out({ ok: false, status: "fail", out: e.message, why: e.message, files: [] }, 2);
}
const { flags, pos } = parsed;
const cmd = pos[0];
const ROOT = stateRoot(app.name);
const stateDir = (id) => path.join(ROOT, id);
const statePath = (id) => path.join(stateDir(id), "state.json");
const readState = (id) => {
  try {
    return JSON.parse(fs.readFileSync(statePath(id), "utf8"));
  } catch {
    return null;
  }
};

/**
 * The source's .env.kitchen, or this Toolkit's own (the repo it was committed with) when the source has none:
 * Kitchen may run an approved Toolkit against a job worktree that doesn't hold its files.
 */
function envFileOf(src) {
  const own = path.join(src, ".env.kitchen");
  return fs.existsSync(own) ? own : path.join(TOOLKIT_DIR, "..", "..", ".env.kitchen");
}

/** Feature files: the source's, plus this Toolkit's own that the source lacks (same reason). */
function featureFilesOf(src) {
  const names = new Set();
  for (const dir of [path.join(src, ".kitchen", "toolkit", "features"), path.join(TOOLKIT_DIR, "features")])
    if (fs.existsSync(dir)) for (const f of fs.readdirSync(dir)) if (f.endsWith(".md") && f !== "README.md") names.add(f);
  return [...names].sort().map((f) => `features/${f}`);
}

function srcOf() {
  const src = path.resolve(String(flags.src || path.resolve(TOOLKIT_DIR, "..", "..")));
  if (!fs.existsSync(src)) throw new Error(`--src ${src} does not exist`);
  return src;
}

/** What app.mjs gets: the instance, its state (saved with ctx.save()), and helpers that record what they start. */
function context(id, state) {
  const src = state?.src ?? srcOf();
  const ctx = {
    id,
    src,
    toolkitDir: TOOLKIT_DIR,
    stateDir: id ? stateDir(id) : null,
    state: state ?? {},
    ports: state?.ports ?? [],
    env: readEnvFile(envFileOf(src)),
    log,
    run,
    must,
    appEnv,
    waitFor,
    httpJson,
    save() {
      fs.mkdirSync(stateDir(id), { recursive: true });
      fs.writeFileSync(statePath(id), JSON.stringify(ctx.state, null, 2));
    },
    /** Start a long-lived app process (own process group, app env, log in the state dir). `down` kills it. */
    spawn(name, command, args, o = {}) {
      const pid = spawnDetached(command, args, { cwd: o.cwd ?? src, env: appEnv(o.env ?? {}), logFile: path.join(stateDir(id), `${name}.log`) });
      ctx.state.pids = { ...(ctx.state.pids ?? {}), [name]: pid };
      ctx.save();
      return pid;
    },
    /** `docker run -d` with this instance's labels, so `down` finds it. Returns the container name. */
    container(name, args) {
      const cname = `kitchen-${app.name}-${id}-${name}`;
      run("docker", ["rm", "-f", cname], { quiet: true });
      must("docker", ["run", "-d", "--name", cname, "--label", `kitchen.toolkit=${app.name}`, "--label", `kitchen.id=${id}`, ...args]);
      ctx.state.containers = [...new Set([...(ctx.state.containers ?? []), cname])];
      ctx.save();
      return cname;
    },
    /** `docker compose -p <this instance's project>`; `down` runs `compose down -v` for every project recorded. */
    compose(args, o = {}) {
      const project = `kitchen-${app.name}-${id}`.replace(/[^a-z0-9_-]/g, "-");
      if (!(ctx.state.compose ?? []).some((c) => c.project === project)) {
        ctx.state.compose = [...(ctx.state.compose ?? []), { project, files: o.files ?? [], cwd: o.cwd ?? src }];
        ctx.save();
      }
      const fileArgs = (o.files ?? []).flatMap((f) => ["-f", f]);
      return must("docker", ["compose", "-p", project, ...fileArgs, ...args], { cwd: o.cwd ?? src, env: { ...process.env, ...(o.env ?? {}) } });
    },
  };
  return ctx;
}

async function teardown(id) {
  const state = readState(id) ?? {};
  const ctx = context(id, { src: state.src ?? srcOf(), ...state });
  const stopped = [];
  try {
    if (app.down) await app.down(ctx);
  } catch (e) {
    log("app.down:", e.message);
  }
  for (const [name, pid] of Object.entries(state.pids ?? {})) if (await killGroup(pid)) stopped.push(name);
  for (const c of state.compose ?? []) {
    const f = c.files.flatMap((x) => ["-f", x]);
    if (run("docker", ["compose", "-p", c.project, ...f, "down", "-v", "--remove-orphans", "--rmi", "local"], { cwd: c.cwd, quiet: true }).code === 0) stopped.push(c.project);
  }
  const labelled = run("docker", ["ps", "-aq", "--filter", `label=kitchen.toolkit=${app.name}`, "--filter", `label=kitchen.id=${id}`], { quiet: true })
    .stdout.split("\n")
    .filter(Boolean);
  if (labelled.length) {
    run("docker", ["rm", "-f", "-v", ...labelled], { quiet: true });
    stopped.push(...(state.containers ?? labelled));
  }
  // Logs stay for post-mortems; only the live-state marker goes. Evidence is never here.
  fs.rmSync(statePath(id), { force: true });
  return stopped;
}

const COMMANDS = {
  async prepare() {
    const ctx = context(null, null);
    const extra = (await app.prepare?.(ctx)) ?? {};
    out({ status: "ok", secs: secs(), ...extra });
  },

  async up() {
    const id = checkId(flags.id);
    const src = srcOf();
    const ports = String(flags.ports || "")
      .split(",")
      .map(Number)
      .filter(Boolean);
    if (ports.length < app.ports.needs) return out({ status: "fail", why: `--ports needs at least ${app.ports.needs} ports (${app.ports.order.join(", ")})` });
    if (readState(id)) return out({ status: "fail", why: `id ${id} is already up (run down first)` });
    const ctx = context(id, { id, src, ports: ports.slice(0, app.ports.needs), startedAt: new Date().toISOString() });
    ctx.save();
    try {
      const r = await app.up(ctx);
      ctx.state.url = r.url;
      ctx.save();
      out({ status: "ready", url: r.url, secs: secs(), ...(r.extra ?? {}) });
    } catch (e) {
      log("up failed, cleaning up:", e.message);
      await teardown(id);
      out({ status: "fail", why: e.message, secs: secs() });
    }
  },

  async doctor() {
    const id = checkId(flags.id);
    const state = readState(id);
    if (!state) return out({ status: "fail", checks: [{ name: "state", ok: false, why: `id ${id} is not up` }] });
    const ctx = context(id, state);
    const checks = [];
    for (const [name, pid] of Object.entries(state.pids ?? {})) checks.push({ name: `${name} process alive`, ok: alive(pid), ...(alive(pid) ? {} : { why: `pid ${pid} gone` }) });
    for (const [name, fn] of Object.entries(app.doctor(ctx))) {
      try {
        const r = await fn();
        checks.push({ name, ok: r === true, ...(r === true ? {} : { why: String(r) }) });
      } catch (e) {
        checks.push({ name, ok: false, why: e.message });
      }
    }
    out({ status: checks.every((c) => c.ok) ? "ok" : "fail", checks, secs: secs() });
  },

  async reset() {
    const id = checkId(flags.id);
    const state = readState(id);
    if (!state) return out({ status: "fail", why: `id ${id} is not up` });
    const ctx = context(id, state);
    await app.reset(ctx);
    ctx.save();
    out({ status: "ok", secs: secs() });
  },

  async down() {
    const id = checkId(flags.id);
    out({ status: "ok", stopped: await teardown(id), logs: stateDir(id), secs: secs() });
  },

  // Generated from app.mjs and the feature files in --src: never hand-kept.
  async describe() {
    const features = featureFilesOf(srcOf());
    const ctx = context(null, null);
    out({
      status: "ok",
      contract: CONTRACT,
      toolkit: app.name,
      surface: app.surface,
      lifecycle: LIFECYCLE,
      primitives: Object.entries(app.primitives).map(([name, p]) => ({ name, args: p.args ?? {}, does: p.does })),
      features,
      seed_users: (await app.seedUsers?.(ctx)) ?? [],
      externals: app.externals ?? [],
      ports: app.ports,
      parallel: app.parallel !== false,
    });
  },
};

async function primitive(name) {
  const id = checkId(flags.id);
  const state = readState(id);
  if (!state) return out({ ok: false, out: `id ${id} is not up`, files: [] });
  const { id: _i, src: _s, out: outDir, ports: _p, ...args } = flags;
  const ctx = context(id, state);
  ctx.out = typeof outDir === "string" ? path.resolve(outDir) : null;
  if (ctx.out) fs.mkdirSync(ctx.out, { recursive: true });
  log(name, JSON.stringify(args));
  const r = await app.primitives[name].run(ctx, args);
  ctx.save();
  out({ ok: r.ok === true, out: r.out ?? null, files: r.files ?? [] });
}

try {
  if (COMMANDS[cmd]) await COMMANDS[cmd]();
  else if (app.primitives[cmd]) await primitive(cmd);
  else out({ status: "fail", why: `unknown command ${JSON.stringify(cmd)}; try describe` }, 2);
} catch (e) {
  out(app.primitives[cmd] ? { ok: false, out: e.message, files: [] } : { status: "fail", why: e.message, secs: secs() }, 1);
}
