{
  "name": "devkitchen",
  "version": "0.1.0",
  "description": "Kitchen: turns tickets into proven, reviewed pull requests using Claude Code or Codex",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "pull-requests",
    "software-factory",
    "verification"
  ],
  "license": "Apache-2.0",
  "author": "Kitchen contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/kitchen.git"
  },
  "homepage": "https://github.com/OWNER/kitchen#readme",
  "bugs": {
    "url": "https://github.com/OWNER/kitchen/issues"
  },
  "type": "module",
  "bin": {
    "kitchen": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "roles/",
    "skills/",
    "toolkit-template/",
    "!toolkit-template/node_modules/",
    "dashboard/dashboard.html",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepack": "rm -rf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "execa": "^10.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
